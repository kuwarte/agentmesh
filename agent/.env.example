# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AgentMesh gateway URL
GATEWAY_URL=http://localhost:3001

# Agent wallet private key (must have MockUSDC balance + facilitator approved)
AGENT_PRIVATE_KEY=your_agent_wallet_private_key

# X402Facilitator contract address (from your deployment)
FACILITATOR_ADDRESS=0x91D4DEBefB1d914298bc7354f8385cA7Fb51c239

# Task for the agent to complete (override via CLI arg too)
AGENT_TASK=Perform a crypto market analysis and tell me if now is a good time to trade

# MockUSDC contract address (for auto-approve on startup)
USDC_ADDRESS=0x3f846eBAe8e2cfA224DF95222640FC73C9A8412C

# Morph Hoodi RPC (for on-chain approve transaction)
RPC_URL=https://rpc-hoodi.morphl2.io
