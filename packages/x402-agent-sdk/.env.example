# ── Required ──────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=0x...                         # your agent wallet private key
GROQ_API_KEY=gsk_...                            # from https://console.groq.com/keys

# ── Gateway (change if your backend runs elsewhere) ───────────────────────────
GATEWAY_URL=http://localhost:3001

# ── Deployed contracts (Morph Hoodi Testnet, Chain ID: 2910) ──────────────────
X402_FACILITATOR_ADDRESS=0x980938b322d653789dE859b4aB0119C0b02016f4
USDC_ADDRESS=0xC6F74786d5a0149611a77a2C2ABE1A049C48d492
RPC_URL=https://rpc-hoodi.morphl2.io

# ── Optional: on-chain USDC handling ──────────────────────────────────────────
# AUTO_APPROVE=true            # automatically approve USDC spending
# AUTO_MINT=true               # automatically mint test tokens if balance is 0

# ── Optional: behaviour flags ─────────────────────────────────────────────────
# DEBUG=true                   # shows every HTTP request in a debug tree
# VERBOSE=true                 # rich TUI (enabled by default)
# MODEL_NAME=                  # override the default Llama model (llama-3.3-70b-versatile)

# ── Alternative LLM (OpenAI instead of Groq) ──────────────────────────────────
# OPENAI_API_KEY=sk-...
