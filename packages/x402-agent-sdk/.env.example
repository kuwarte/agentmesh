# ── Required ──────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=0xYourPrivateKeyHere          # your wallet private key
GROQ_API_KEY=gsk_YourGroqKeyHere                # from https://console.groq.com/keys
FACILITATOR_ADDRESS=0x91D4DEBefB1d914298bc7354f8385cA7Fb51c239   # X402Facilitator contract

# ── Gateway (change if your backend runs elsewhere) ───────────────────────────
GATEWAY_URL=http://localhost:3001

# ── Optional: on‑chain USDC handling ──────────────────────────────────────────
# USDC_ADDRESS=0x3f846eBAe8e2cfA224DF95222640FC73C9A8412C
# RPC_URL=https://rpc-hoodi.morphl2.io
# AUTO_APPROVE=true            # automatically approve USDC spending
# AUTO_MINT=true               # automatically mint test tokens if balance is 0

# ── Optional: behaviour flags ─────────────────────────────────────────────────
# DEBUG=true                   # shows every HTTP request in a debug tree
# VERBOSE=true                 # premium TUI (true by default)
# MODEL_NAME=                  # override the default Llama model
