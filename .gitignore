# .gitignore (root dir)

# ============================================
# Dependencies
# ============================================
node_modules/
.pnp
.pnp.js

# ============================================
# Build Outputs
# ============================================
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep example file
!.env.example

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Testing
# ============================================
coverage/
*.lcov
.nyc_output/
.jest-cache/

# ============================================
# Cache & Temp Files
# ============================================
.cache/
.temp/
*.tmp
*.swp
*.swo
*~

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# IDEs & Editors
# ============================================

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.iws
*.ipr

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
.netrwhist
tags

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-workspace
*.sublime-project

# ============================================
# Smart Contracts (Hardhat/Foundry)
# ============================================
cache/
artifacts/
typechain/
typechain-types/

# Hardhat
coverage.json
.hardhat/

# Foundry
out/
cache_hardhat/
broadcast/

# ============================================
# Next.js Specific
# ============================================
.next/
.vercel
*.tsbuildinfo
next-env.d.ts

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3
prisma/migrations/

# ============================================
# Deployment & CI/CD
# ============================================
.vercel/
.netlify/
.railway/
.render/

# ============================================
