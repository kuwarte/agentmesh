# Morph Hoodi Testnet (Chain ID: 2910)
# Explorer: https://explorer-hoodi.morphl2.io

RPC_URL=https://rpc-hoodi.morphl2.io
CHAIN_NAME=morph_hoodi

# Your wallet private key (deployer / gateway signer)
GATEWAY_PRIVATE_KEY=0x...

AGENT_PRIVATE_KEY=<agent_wallet_private_key>

# Deployed contract addresses (fill after running forge script)
API_REGISTRY_ADDRESS=0x...
X402_FACILITATOR_ADDRESS=0x...
USDC_ADDRESS=0x...

# Provider wallet that receives API payments
PROVIDER_ADDRESS=0x...

# Treasury wallet that receives 1% fee
TREASURY_ADDRESS=0x...

# ─── Supabase (off-chain API metadata) ───────────────────────────────────────
# Create a project at https://supabase.com and run the SQL in
# src/services/metadata.service.ts to create the api_metadata table.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
