# Morph Hoodi Testnet (Chain ID: 2910)
# Explorer: https://explorer-hoodi.morphl2.io

RPC_URL=https://rpc-hoodi.morphl2.io
CHAIN_NAME=morph_hoodi

# Your wallet private key (deployer / gateway signer)
GATEWAY_PRIVATE_KEY=0x...

# Agent wallet private key
AGENT_PRIVATE_KEY=0x...

# Public URL of this backend (used to register built-in feed endpoints on-chain at startup)
# Set this to your actual deployed URL before first run, e.g. https://your-backend.railway.app
# If left as localhost, built-in feeds will be registered with an unreachable endpoint.
GATEWAY_URL=http://localhost:3001

# Port (optional — defaults to 3001; most platforms inject this automatically)
PORT=3001

# Deployed contract addresses
API_REGISTRY_ADDRESS=0x007c677F96A5E934D84502Ccd81FD161023b2cfA
X402_FACILITATOR_ADDRESS=0x980938b322d653789dE859b4aB0119C0b02016f4
USDC_ADDRESS=0xC6F74786d5a0149611a77a2C2ABE1A049C48d492

# Block when X402Facilitator was deployed (avoids scanning from block 0 on startup)
FACILITATOR_DEPLOY_BLOCK=5652133

# Provider wallet that receives API payments (99%)
PROVIDER_ADDRESS=0x...

# Treasury wallet that receives 1% fee
TREASURY_ADDRESS=0x...

# Internal API key (optional, for protected admin routes)
INTERNAL_API_KEY=

# ─── Supabase (off-chain API metadata) ───────────────────────────────────────
# Create a project at https://supabase.com and run the SQL in
# src/services/metadata.service.ts to create the api_metadata table.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
